<form hx-post="/devices/new" class="{{ status }}" hx-swap="outerHTML">
    <input type="text" name="id" placeholder="ID" required value="{{ id }}">
    <input type="text" name="model" placeholder="Model" required value ="{{ model }}">
    <button type="submit">Submit</button>
    {% if status == "error" %}
        <p class="error">{{ message }}</p>
    {% else %}
        <p> class="success">{{ message }}</p>
    
    {% endif %}

</form>