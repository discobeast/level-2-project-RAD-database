{% extends "pages/_base.jinja" %}

{% block title %}- {{ device.id }}{% endblock  %}

{% block header %}
    <a href="/"><h1>{{device.id}}</h1></a>
    <h2>{{device.model}}</h2>
{% endblock header %}


{% block content %}
    <div id="checklist">
        <form action="/devices/{{device.id}}/checklist" method="post" id="checklist_form">
            {% for check in device.checks %}
                <div class="checklist_item">
                        <label>
                            <input type="checkbox" name="{{check.id}}-check_passed" id="check_passed" {% if check.status == 1 %} checked {% endif %}>
                            {{check.name}}
                        </label>

                            {# <input type="text" name="{{check.id}}-notes" class="check_notes" value="{% if check.note %}{{check.note}}{% endif %}" placeholder="Notes..">  #}
                            <textarea name="{{check.id}}-notes" class="check_notes" placeholder="Notes..">{% if check.note %}{{check.note}}{% endif %}</textarea>
                </div>
            {% endfor %}
            <input type="submit" value="Submit">
        </form>
    </div>

    <div id="worklogs">
        <form action="/devices/{{ device.id }}/worklog" method="post">
            <input type="text" name="name" id="name" placeholder="Name" required>
            <textarea name="notes" id="notes" placeholder="Notes.." required></textarea>
            <input type="submit" value="Submit">
        </form>
        <div id="logs">
            {% for log in device.worklogs %}
                <div class="log">
                    <p>{{ log.user }}</p>
                    <p class="log_notes">{{ log.notes }}</p>
                    <p class="log_timestamp">{{ log.timestamp }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
    <div hx-confirm="Are you sure?" id="delete_device">
        <button hx-get="/devices/{{ device.id }}/delete?confirmed=true" class="btn danger">
            Delete
        </button>
        
    </div>
{% endblock  %}
