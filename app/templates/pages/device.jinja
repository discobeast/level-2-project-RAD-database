{% extends "pages/_base.jinja" %}

{% block title %}- {{ device.id }}{% endblock  %}

{% block content %}
    <h1>{{device.name}}</h1>
    <h2>{{device.id}}</h2>
    <div id="checklist">
    <form action="/devices/{{device.id}}" method="post">
        {% for check in device.checks %}
            <div class="checklist_item">
                    <p>{{check.name}}</p>
                    <input type="checkbox" name="{{check.id}}-check_passed" id="check_passed" {% if check.passed %} checked {% endif %}>
                    <label for="check_passed"></label>
                    <input type="text" name="{{check.id}}-notes" id="notes" value="{{check.notes}}">
                    <label for="notes"></label>
            </div>
        {% endfor %}
        <input type="submit" value="Submit">
        </form>
    </div>
{% endblock  %}

