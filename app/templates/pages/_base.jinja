{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>The negachin!! {% block title %}{% endblock %}</title>

    <script src="/static/js/utils.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.js" integrity="sha384-Q+Dky3iHVJOr6wUjQ4ulh6uQ76an/t+ak1+PjMVaxRjbZamFLAG+u9InkfjbsEQf" crossorigin="anonymous"></script>

    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    <header>
        <div id="user">
            <img src="" alt="" id="profile">
            <p id="name"></p>
        </div>
    </header>

    <main>

        <div id="graphs">
            <h1>TBD</h1>
        </div>

        <div id="device_list">

            <div id="bar">
                <div id="filter">
                    <img src="" alt="" id="filter_icon">
                    <p class="filter_option">filter-1</p>
                    <p class="filter_option">filter-2</p>
                    <p class="filter_option">filter-3</p>
                </div>
                <img src="" alt="" id="add">
            </div>

            <div id="devices">
                {% for device in devices %}
                    <div class="device">
                        <div class="icon"></div>
                        <p class="code">{{device.id}}</p>
                        <p class="model">{{device.model}}</p>
                    </div>
                {% endfor %}
            </div>

        </div>
    </main>
</body>

</html>

