{% extends "pages/_base.jinja" %}

{% block header %}
    <h1>The RAD database</h1>
{% endblock header %}

{% block content %}
    <div id="device_list">
        <input type="search" name="query" id="query" hx-post="/devices/" hx-trigger="load,input changed delay:500ms" hx-target="#devices" hx-swap="innerhtml" placeholder="Search">
        <form hx-post="/devices/new" hx-swap="outerHTML">
            <input type="text" name="id" id="id" placeholder="ID" required>
            <input type="text" name="model" id="model" placeholder="Model" required>
            <button type="submit">Submit</button>
        </form>

        <div id="devices">
        </div>
    </div>
{% endblock  %}

