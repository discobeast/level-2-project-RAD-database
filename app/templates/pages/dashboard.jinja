{% extends "pages/_base.jinja" %}


{% block content %}
    <div id="graphs">
        <h1>TBD</h1>
    </div>

    <div id="device_list">

        <div id="bar">
            <div id="filter">
                <img src="" alt="" id="filter_icon">
                <p class="filter_option">filter-1</p>
                <p class="filter_option">filter-2</p>
                <p class="filter_option">filter-3</p>
            </div>
            <img src="" alt="" id="add">
        </div>

        <div id="devices">
            {% for device in devices %}
                <a class="device status-{{device.id}}" href="/devices/{{device.id}}">
                    <div class="icon"></div>
                    <p class="code">{{device.id}}</p>
                    <p class="model">{{device.model}}</p>
                </a>
            {% endfor %}
        </div>

    </div>
{% endblock  %}

