{% extends "pages/_base.jinja" %}

{% block header %}
    <h1>The RAD database</h1>
{% endblock header %}

{% block content %}
    <div id="device_list">
        <form hx-post="/devices/new" hx-swap="outerHTML">
            <input type="text" name="id" id="id" placeholder="ID" required>
            <input type="text" name="model" id="model" placeholder="Model" required>
            <button type="submit">Submit</button>
        </form>

        <div id="devices">
            {% for device in devices %}
                <a class="device status-{{device.id}}" href="/devices/{{device.id}}">
                    <p class="code">{{device.id}}</p>
                    <p class="model">{{device.model}}</p>
                    <p class="timestamp">Latest work done: {% if device.timestamp %}{{device.timestamp}} by {{device.last_user}}{% else %}Not started{% endif %}</p>
                </a>
            {% endfor %}
        </div>
    </div>
{% endblock  %}

