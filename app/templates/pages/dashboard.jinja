{% extends "pages/_base.jinja" %}


{% block content %}
    <div id="device_list">
        
        <div id="devices">
            {% for device in devices %}
                <a class="device status-{{device.id}}" href="/devices/{{device.id}}">
                    <p class="code">{{device.id}}</p>
                    <p class="model">{{device.model}}</p>
                </a>
            {% endfor %}
        </div>

    </div>
{% endblock  %}

