{% extends "pages/_base.jinja" %}


{% block content %}
    <div id="device_list">
        <form hx-post="/devices/new" hx-swap="none">
            <input type="text" name="id" placeholder="ID" required>
            <input type="text" name="model" placeholder="Model" required>
            <button type="submit">Submit</button>
        </form>
        <div hx-on="deviceExists from:body -> console.log('Item created!')"></div>
        <div id="devices">
            {% for device in devices %}
                <a class="device status-{{device.id}}" href="/devices/{{device.id}}">
                    <p class="code">{{device.id}}</p>
                    <p class="model">{{device.model}}</p>
                </a>
            {% endfor %}
        </div>

    </div>
{% endblock  %}

