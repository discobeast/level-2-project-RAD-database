{% extends "pages/_base.jinja" %}

{% block header %}
    <h1>The RAD database</h1>
{% endblock header %}

{% block content %}
    <div id="device_list">
        <form hx-post="/devices/new" hx-swap="outerHTML" id="device_creation">
            <input type="text" name="id" id="id" placeholder="ID" required>
            <input type="text" name="model" id="model" placeholder="Model" required>
            <button type="submit">Create device</button>
        </form>

        <form hx-post="/devices/" hx-trigger="load, input changed from:#search_bar>#query delay:500ms,change from:#search_bar>input[type=checkbox]" hx-target="#devices" hx-swap="innerhtml" id="search_bar">
            <input type="search" name="query" id="query" placeholder="Search">
            <input type="checkbox" name="filter_unloved" id="unloved">
            <input type="checkbox" name="filter_bricked" id="bricked">
        </form>

        <div id="devices">
        </div>
    </div>
{% endblock  %}

